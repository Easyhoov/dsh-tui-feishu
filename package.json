{
  "name": "dsh-tui-feishu",
  "version": "0.8.0",
  "description": "Feishu (Lark) remote-control surface for dsh-TUI: chat with your local agent from Feishu, scan-to-pair QR setup, streaming reply cards, in-card approvals",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "ADMISSION.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/smoke.mjs && node test/redact.mjs && node test/robustness.mjs && node test/cards-p1.mjs && node test/cardkit.mjs && node test/images.mjs && node test/files.mjs && node test/reply.mjs && node test/reply-guard.mjs && node test/watchdog.mjs && node test/history.mjs && node test/image-fallback.mjs && node test/outbound-files.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify": "npm run build && npm run validate:manifest && npm test"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Easyhoov/dsh-tui-feishu.git"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
